+/// Returns true once any EGL call in this process has failed with
+/// EGL_CONTEXT_LOST.
+///
+/// A lost display is permanent: this embedder has no path that recreates the
+/// display, config or contexts (see egl::Manager::CleanUp), so once this
+/// returns true the renderer can never present another frame and the process
+/// must be restarted to recover. Safe to call from any thread.
+bool IsContextLost();
+
+/// Registers a callback invoked when EGL_CONTEXT_LOST is first observed. Pass
+/// nullptr to unregister.
+///
+/// The callback returns whether it actually delivered the notification.
+/// Returning false lets a later EGL failure try again, so one dropped delivery
+/// is not permanent - which matters because a host that misses the notification
+/// has no way to learn of the loss except by polling IsContextLost.
+///
+/// The callback runs on whichever thread observed the loss - in practice the
+/// raster thread, mid-failure - so it must be cheap, non-blocking, and must not
+/// re-enter the engine. Safe to call from any thread.
+void SetContextLostCallback(bool (*callback)());
+
 }  // namespace egl
 }  // namespace flutter
 
