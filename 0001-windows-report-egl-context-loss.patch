+
 void LogEGLError(std::string_view message) {
   const EGLint error = ::eglGetError();
+
+  // EGL_CONTEXT_LOST is unrecoverable here, and unlike every other error in
+  // this switch it is not a programming mistake - it is the GPU going away
+  // underneath a healthy process (a TDR, a driver reset, an adapter change).
+  // Nothing in this embedder recreates the display afterwards, so the
+  // rasterizer will silently fail to draw for the rest of the process's life
+  // while the engine keeps reporting completed frames. Latch it and tell the
+  // host exactly once, so it can restart rather than sit there frozen.
+  if (error == EGL_CONTEXT_LOST) {
+    // Set the pollable flag first and unconditionally, so a host that polls sees
+    // the loss even if every notification attempt fails.
+    g_context_lost.store(true, std::memory_order_release);
+
+    // Notify once - but only treat it as done once delivery actually succeeded.
+    // A notification dropped here would be permanent, and the host has no other
+    // way to learn of the loss short of asking. A lost context keeps producing
+    // EGL failures, so a later one retries.
+    if (!g_context_lost_notified.exchange(true, std::memory_order_acq_rel)) {
+      const auto callback =
+          g_context_lost_callback.load(std::memory_order_acquire);
+      if (callback == nullptr || !callback()) {
+        g_context_lost_notified.store(false, std::memory_order_release);
+      }
+    }
+  }
+
   return FML_LOG(ERROR) << "EGL Error: " << EGLErrorToString(error) << " ("
                         << error << ") " << message;
 }
