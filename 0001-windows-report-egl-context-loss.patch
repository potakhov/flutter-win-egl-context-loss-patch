+// Both are process-wide because the ANGLE display they describe is process-wide
+// - see flutter::egl::IsContextLost.
+std::atomic<HWND> g_context_lost_hwnd{nullptr};
+std::atomic<UINT> g_context_lost_message{0};
+
+bool PostGraphicsContextLost() {
+  const HWND hwnd = g_context_lost_hwnd.load(std::memory_order_acquire);
+  const UINT message = g_context_lost_message.load(std::memory_order_acquire);
+  if (hwnd == nullptr || message == 0) {
+    return false;
+  }
+
+  // Post rather than send. This runs on whichever thread first observed the
+  // loss - in practice the raster thread, part way through a failing frame - so
+  // it must not block on the platform thread and must not re-enter the engine.
+  // PostMessage is safe from any thread and returns immediately.
+  //
+  // Report whether it was actually queued. A window torn down mid-teardown, or
+  // a full queue, fails here; saying so lets a later EGL failure retry instead
+  // of leaving the host permanently unaware.
+  return ::PostMessage(hwnd, message, 0, 0) != 0;
+}
+
+}  // namespace
+
+void FlutterDesktopSetGraphicsContextLostNotification(HWND hwnd, UINT message) {
+  g_context_lost_message.store(message, std::memory_order_release);
+  g_context_lost_hwnd.store(hwnd, std::memory_order_release);
+  flutter::egl::SetContextLostCallback(
+      hwnd != nullptr ? &PostGraphicsContextLost : nullptr);
+
+  // A loss that happened before this call has already consumed its one
+  // notification attempt, so report it here instead. This is what makes
+  // registration order irrelevant to the host.
+  if (hwnd != nullptr && message != 0 && flutter::egl::IsContextLost()) {
+    ::PostMessage(hwnd, message, 0, 0);
+  }
+}
+
+bool FlutterDesktopIsGraphicsContextLost() {
+  return flutter::egl::IsContextLost();
+}
